{
    "version": "0.2.0",
    "configurations": [
        {
            // Depura con Node.js el archivo .js que tengas abierto en el editor.
            "type": "node",
            "request": "launch",
            "name": "Depurar archivo actual (Node)",
            // ${file} = ruta del archivo abierto en la pestaña activa.
            "program": "${file}",
            // Ejecuta el programa desde la carpeta del propio archivo.
            "cwd": "${fileDirname}",
            // Se detiene en la primera línea para inspeccionar las variables desde el inicio.
            "stopOnEntry": true,
            // Muestra los console.log en el terminal integrado de VS Code.
            "console": "integratedTerminal",
            // No entra en el código interno de Node al avanzar paso a paso.
            "skipFiles": ["<node_internals>/**"]
        }
    ]
}
